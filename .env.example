# ---- AI ----
ANTHROPIC_API_KEY=paste-your-key-here
ANTHROPIC_MODEL=claude-haiku-5-5
PORT=3000

# ---- Orders screen (yoursite.com/orders) ----
ADMIN_PASSWORD=choose-a-strong-password

# ---- Meta webhooks (shared by WhatsApp + Instagram) ----
# Any secret phrase you make up; paste the same phrase in the Meta App Dashboard
META_VERIFY_TOKEN=make-up-a-secret-phrase
# App Dashboard > App settings > Basic > App secret
META_APP_SECRET=
# Instagram > API setup with Instagram login > Instagram app secret
IG_APP_SECRET=

# ---- WhatsApp (leave blank to switch off) ----
WA_TOKEN=
WA_PHONE_NUMBER_ID=
# The store's WhatsApp number customers will message (for the website button)
WA_PUBLIC_NUMBER=
# Owner/staff WhatsApp number that receives new-order alerts (digits with country code, e.g. 17805551234)
STORE_ALERT_NUMBER=
# Approved utility template used when the 24-hour window is closed (see README)
WA_ALERT_TEMPLATE=new_order_alert
WA_ALERT_TEMPLATE_LANG=en

# ---- Instagram DMs (leave blank to switch off) ----
IG_TOKEN=
IG_ACCOUNT_ID=
IG_USERNAME=punjabmart_beaumont1
